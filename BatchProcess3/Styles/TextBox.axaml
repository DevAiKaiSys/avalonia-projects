<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20"
                Background="{DynamicResource PrimaryBackground}"
                Height="200"
                Width="300">
            <!-- Add Controls for Previewer Here -->
            <StackPanel Spacing="10">
                <TextBox>Some text box</TextBox>
                <TextBox PasswordChar="*">Some text box</TextBox>
            </StackPanel>

        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="TextBox">
        <!--<Setter Property="BorderBrush"
                Value="{DynamicResource PrimaryButtonBackgroundGradient}" />-->
        <Setter Property="BorderBrush"
                Value="{DynamicResource DefaultGradient}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource PrimaryBorderThickness}" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryBackground}" />
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForeground}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <!--<Setter Property="BorderBrush"
                Value="{DynamicResource PrimaryButtonBackgroundGradient}" />-->
        <Setter Property="BorderBrush"
                Value="{DynamicResource HoverGradient}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource PrimaryBorderThickness}" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryHoverBackground}" />
    </Style>

    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForeground}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <!--<Setter Property="BorderBrush"
                Value="{DynamicResource AlertButtonBackgroundGradient}" />-->
        <Setter Property="BorderBrush"
                Value="{DynamicResource HoverGradient}" />
        <Setter Property="BorderThickness"
                Value="3" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryHoverBackground}" />
    </Style>

</Styles>