<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             xmlns:local="clr-namespace:BatchProcess3.Views"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="850"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:Class="BatchProcess3.Views.ActionsPageView"
             x:DataType="vm:ActionsPageViewModel">

    <Design.DataContext>
        <vm:ActionsPageViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*"
          RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Name="HeaderGrid">
            <Image Source="{SvgImage /Assets/Images/background-actions.svg}"
                   Height="100"
                   Stretch="UniformToFill" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Label Classes="h1"
                       HorizontalAlignment="Center"
                       Content="Actions" />
                <Label Classes="sub2"
                       HorizontalAlignment="Center"
                       Content="Create and manage all actions that can be used in a process" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Padding="25">
            <TabControl Name="ActionsTabControl"
                        SelectionChanged="ActionsTab_OnSelectionChanged"
                        Padding=" 0 15 0 0">
                <TabItem Header="Print"
                         IsSelected="True">
                    <!--<TextBlock Margin="5">This is tab 1 content</TextBlock>-->
                    <local:ActionsPrintView />
                </TabItem>
                <TabItem Header="Custom Properties">
                    <TextBlock Margin="5">This is tab 2 content</TextBlock>
                </TabItem>
                <TabItem Header="File Info" />
                <TabItem Header="Save Model As" />
                <TabItem Header="Save Drawing As" />
                <TabItem Header="Import File" />
                <TabItem Header="Drawing Templates" />
                <TabItem Header="Macros" />
            </TabControl>
        </Border>
    </Grid>
</UserControl>