<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="clr-namespace:BatchProcess3.MainApp"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="800"
             x:DataType="pages:MainViewModel"
             x:Class="BatchProcess3.Views.Pages.MainView"
             xmlns:design="clr-namespace:BatchProcess3.Design"
             xmlns:pages="clr-namespace:BatchProcess3.ViewModels.Pages"
             d:DataContext="{x:Static design:DesignData.MainViewModel}">

    <Grid ColumnDefinitions="Auto,*"
          Background="{DynamicResource PrimaryBackground}">

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}" />

        <Border Grid.Column="0"
                Padding="20"
                Background="{DynamicResource PrimaryBackgroundGradient}">
            <Grid RowDefinitions="*, Auto">
                <StackPanel Spacing="12">
                    <Image Source="{SvgImage /Assets/Images/logo.svg}"
                           Width="220"
                           IsVisible="{Binding SideMenuExpanded}"
                           PointerPressed="InputElement_OnPointerPressed" />
                    <Image Source="{SvgImage /Assets/Images/icon.svg}"
                           Width="22"
                           IsVisible="{Binding !SideMenuExpanded}"
                           PointerPressed="InputElement_OnPointerPressed" />
                    <IconButton Classes="subtle"
                                IconText="&#xe2c2;"
                                HorizontalAlignment="Stretch"
                                Classes.active="{Binding HomePageIsActive}"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static data:ApplicationPageNames.Home}">
                        <Label Content="Home"
                               IsVisible="{Binding SideMenuExpanded}" />
                    </IconButton>
                    <IconButton Classes="subtle"
                                IconText="&#xe346;"
                                HorizontalAlignment="Stretch"
                                Classes.active="{Binding ProcessPageIsActive}"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static data:ApplicationPageNames.Process}">
                        <Label Content="Process"
                               IsVisible="{Binding SideMenuExpanded}" />
                    </IconButton>
                    <IconButton Classes="subtle"
                                IconText="&#xe7f2;"
                                HorizontalAlignment="Stretch"
                                Classes.active="{Binding ActionsPageIsActive}"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static data:ApplicationPageNames.Actions}">
                        <Label Content="Actions"
                               IsVisible="{Binding SideMenuExpanded}" />
                    </IconButton>
                    <IconButton Classes="subtle"
                                IconText="&#xe3ee;"
                                HorizontalAlignment="Stretch"
                                Classes.active="{Binding MacrosPageIsActive}"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static data:ApplicationPageNames.Macros}">
                        <Label Content="Macros"
                               IsVisible="{Binding SideMenuExpanded}" />
                    </IconButton>
                    <IconButton Classes="subtle"
                                IconText="&#xeb7a;"
                                HorizontalAlignment="Stretch"
                                Classes.active="{Binding ReporterPageIsActive}"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static data:ApplicationPageNames.Reporter}">
                        <Label Content="Reporter"
                               IsVisible="{Binding SideMenuExpanded}" />
                    </IconButton>
                    <IconButton Classes="subtle"
                                IconText="&#xe03a;"
                                HorizontalAlignment="Stretch"
                                Classes.active="{Binding HistoryPageIsActive}"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static data:ApplicationPageNames.History}">
                        <Label Content="History"
                               IsVisible="{Binding SideMenuExpanded}" />
                    </IconButton>
                </StackPanel>

                <Button Grid.Row="1"
                        Classes="transparent subtle"
                        Classes.active="{Binding SettingsPageIsActive}"
                        Command="{Binding GoToPageCommand}"
                        CommandParameter="{x:Static data:ApplicationPageNames.Settings}">
                    <Label Classes="icon-only"
                           Content="&#xE272;" />
                </Button>
            </Grid>
        </Border>

        <!--<Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              IsVisible="{Binding CurrentDialog.IsDialogOpen}">
            <Border Background="Black"
                    Opacity="0.5" />
            <ContentControl Content="{Binding CurrentDialog}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>-->
        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              Name="DialogOverlay"
              IsVisible="{Binding #DialogOverlay.Opacity}"
              Opacity="{Binding Dialog.IsDialogOpen, FallbackValue=0}">

            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity"
                                              Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <Border Background="Black"
                    Opacity="0.5" />
            <ContentControl Content="{Binding Dialog}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>