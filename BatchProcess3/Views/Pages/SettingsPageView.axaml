<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             Loaded="Control_OnLoaded"
             x:DataType="pages:SettingsPageViewModel"
             x:Class="BatchProcess3.Views.Pages.SettingsPageView"
             xmlns:design="clr-namespace:BatchProcess3.Design"
             xmlns:pages="clr-namespace:BatchProcess3.ViewModels.Pages"
             d:DataContext="{x:Static design:DesignData.SettingsPageViewModel}">

    <!--<UserControl.Styles>
        <Style Selector="Label.h1">
            <Setter Property="FontSize"
                    Value="34" />
            <Setter Property="FontWeight"
                    Value="Black" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>
        <Style Selector="Label.sub1">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0 -5 0 0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource AlertButtonBackgroundGradient}" />
        </Style>
        <Style Selector="TextBlock.sub1">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0 -5 0 0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource AlertButtonBackgroundGradient}" />
        </Style>
        <Style Selector="Label.sub2">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0 -5 0 0" />
        </Style>
        <Style Selector="Label.success">
            <Setter Property="Foreground"
                    Value="{DynamicResource SuccessGradient}" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryBackgroundGradient}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="BorderThickness"
                    Value="3" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForeground}" />
        </Style>

        <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryHoverBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForeground}" />
        </Style>

        <Style Selector="ListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryHoverBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForeground}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryButtonBackgroundGradient}" />
            <Setter Property="BorderThickness"
                    Value="3" />
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForeground}" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryButtonBackgroundGradient}" />
            <Setter Property="BorderThickness"
                    Value="3" />
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryHoverBackground}" />
        </Style>

        <Style Selector="TextBox:pointerover, TextBox:focus">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForeground}" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource AlertButtonBackgroundGradient}" />
            <Setter Property="BorderThickness"
                    Value="3" />
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryHoverBackground}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Margin"
                    Value="0 10" />
            <Setter Property="Padding"
                    Value="0 10" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryButtonBackgroundGradient}" />
            <Setter Property="BorderThickness"
                    Value="3" />
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryBackground}" />
        </Style>

    </UserControl.Styles>-->

    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, *">
        <!-- Header -->
        <HeaderBanner Grid.ColumnSpan="2"
                      BackgroundImage="{SvgImage /Assets/Images/background-settings.svg}"
                      Header="Settings"
                      SubHeaderA="Version 3.0.0.2 Beta"
                      SubHeaderB="Compiled Nov 28 2024  03:14" />

        <!-- Left Side Content -->
        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    Spacing="15"
                    Margin="25">
            <!-- General -->
            <StackPanel>
                <Label Classes="h2"
                       Content="General" />
                <Grid ColumnDefinitions="*, 20, Auto"
                      RowDefinitions="Auto, 20, Auto, 20, Auto">

                    <!-- Release License -->
                    <TextBlock TextWrapping="Wrap"
                               Text="Remove license of BatchProcess from this machine and release the license back to the server ready to be transferred to another machine." />
                    <!--<Button Grid.Row="0"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe2fe;" />
                            <Label Classes="akko"
                                   Content="Release License" />
                        </StackPanel>
                    </Button>-->
                    <IconButton Classes="small"
                                IconText="&#xe2fe;"
                                Content="Release License"
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch" />

                    <!-- Skip Files -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               TextWrapping="Wrap"
                               Text="Skip files if only Open, Save (Optional) and Close are valid actions." />
                    <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding SkipNoActionFiles}" />

                    <!-- Duplicate Entries -->
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               TextWrapping="Wrap"
                               Text="Allow duplicate entries of the same file in project list" />
                    <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding AllowDuplicateEntries}" />
                </Grid>
            </StackPanel>

            <!-- Locations -->
            <StackPanel>
                <Label Classes="h2"
                       Content="Locations" />
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Add or remove the locations to search for Reporter Templates, 
Macros, Actions and other custom files or templates." />
                        <TextBlock Classes="sub1"
                                   TextWrapping="Wrap"
                                   Text="* All sub-directories will be searched automatically" />
                    </StackPanel>

                    <Button Classes="outline small" Grid.Row="0" Grid.Column="1" Content="+ Folder"
                            Command="{Binding AddLocationPathCommand}" HorizontalAlignment="Stretch" Margin="10 0 0 0" />
                </Grid>

            </StackPanel>

        </StackPanel>

        <ListBox Grid.Column="0" Grid.Row="2" ItemsSource="{Binding LocationPaths}" Margin="25 0 25 25">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Content="{Binding }"
                               VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Margin="0 -4 -4 -6"
                                Command="{Binding $parent[ListBox].((pages:SettingsPageViewModel)DataContext).DeleteLocationPathCommand}"
                                CommandParameter="{Binding }"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                VerticalAlignment="Center"
                                Classes="smaller danger">
                            <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Right Side Content -->
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Spacing="15" Margin="25">
            <!-- SolidWorks Host -->
            <StackPanel>
                <Label Classes="h2"
                       Content="SolidWorks Host" />
                <TextBlock TextWrapping="Wrap">
                    BatchProcess can work locally on the current machine, or on any machine accessible
                    over the network or even internet.<LineBreak /><LineBreak />
                    Enter the machines IP address, network name or localhost for this machine.
                </TextBlock>
                <ComboBox Width="200" ItemsSource="{Binding SolidWorksHosts}" SelectedItem="{Binding SolidWorksHost}" />
                <Label Classes="sub1 success"
                       Content="Connection established" />
            </StackPanel>

            <!-- PDM Enterprise -->
            <StackPanel>
                <Label Classes="h2"
                       Content="PDM Enterprise" />
                <TextBlock TextWrapping="Wrap"
                           Text="If you are using PDM Enterprise enter the credentials below and test login. BatchProcess can
then automatically handle checking in and out files from PDM Enterprise." />
                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto, Auto"
                      Margin="0 10">
                    <Label Classes="sub2"
                           Grid.Row="0"
                           Grid.Column="0">
                        Vault Name
                    </Label>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding PdmeVaultNames}"
                              SelectedItem="{Binding PdmeVaultName}"
                              Grid.Row="1"
                              Margin="0 0 10 0"
                              HorizontalAlignment="Stretch" />
                    <Label Classes="sub2"
                           Grid.Row="0"
                           Grid.Column="1">
                        Username
                    </Label>
                    <TextBox Grid.Row="1" Margin="0 0 10 0" Grid.Column="1" Text="{Binding PdmeUsername}" />
                    <Label Classes="sub2"
                           Grid.Row="0"
                           Grid.Column="2">
                        Password
                    </Label>
                    <TextBox Grid.Row="1" PasswordChar="*" Grid.Column="2" Text="{Binding PdmePassword}" />
                </Grid>
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <!--<Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe23e;" />
                            <Label Classes="akko"
                                   Content="Login" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe094;" />
                            <Label Classes="akko"
                                   Content="Refresh Vault" />
                        </StackPanel>
                    </Button>-->
                    <IconButton Classes="small" IconText="&#xe23e;" Content="Login" HorizontalAlignment="Stretch"
                                Command="{Binding PdmeLoginCommand}" />
                    <IconButton Classes="outline small"
                                IconText="&#xe094;"
                                Content="Refresh Vault"
                                HorizontalAlignment="Stretch" />
                </StackPanel>
                <Label Classes="sub1 success"
                       Content="Connection Established"
                       Margin="0 0 0 0" />
            </StackPanel>

            <!-- Settings Cache -->
            <StackPanel>
                <Label Classes="h2"
                       Content="Settings Cache" />
                <TextBlock TextWrapping="Wrap">
                    Various settings are stored locally including Processes, Actions, Macros, Reports and History.
                    <LineBreak /><LineBreak />
                    If you are experiencing issues you can try clearing the cache (this won't remove the license).
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            Margin="0 10">
                    <!--<Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xec54;" />
                            <Label Classes="akko"
                                   Content="Clear Cache" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe5de;" />
                            <Label Classes="akko"
                                   Content="Export Cache" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe20c;" />
                            <Label Classes="akko"
                                   Content="Import Cache" />
                        </StackPanel>
                    </Button>-->
                    <IconButton Classes="alert small"
                                IconText="&#xec54;"
                                Content="Clear Cache"
                                HorizontalAlignment="Stretch" />
                    <IconButton Classes="small"
                                IconText="&#xe5de;"
                                Content="Export Cache"
                                HorizontalAlignment="Stretch" />
                    <IconButton Classes="outline small"
                                IconText="&#xe20c;"
                                Content="Import Cache"
                                HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>