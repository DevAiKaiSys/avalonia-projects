<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="800"
        MinWidth="1400"
        MinHeight="800"
        Icon="/Assets/Images/icon.ico"
        WindowStartupLocation="CenterScreen"
        x:Class="BatchProcess3.MainWindow"
        xmlns:design="clr-namespace:BatchProcess3.Design"
        xmlns:pages="clr-namespace:BatchProcess3.Views.Pages"
        Title="BatchProcess v3.0.0"
        d:DataContext="{x:Static design:DesignData.MainViewModel}">
    <pages:MainView />
</Window>