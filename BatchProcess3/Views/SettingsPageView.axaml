<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:Class="BatchProcess3.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <Design.DataContext>
        <vm:SettingsPageViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*, *"
          RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Name="HeaderGrid"
              Grid.ColumnSpan="2">
            <Image Source="{SvgImage /Assets/Images/background-settings.svg}"
                   Height="100"
                   Stretch="UniformToFill" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Label HorizontalAlignment="Center"
                       Content="Settings" />
                <Label HorizontalAlignment="Center"
                       Content="Version 3.0.0.2 Beta" />
                <Label HorizontalAlignment="Center"
                       Content="Compiled Nov 28 2024  03:14" />
            </StackPanel>
        </Grid>

        <!-- Left Side Content -->
        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    Spacing="15"
                    Margin="25">
            <!-- General -->
            <StackPanel>
                <Label Classes="h2"
                       Content="General" />
                <Grid ColumnDefinitions="*, 20, Auto"
                      RowDefinitions="Auto, 20, Auto, 20, Auto">

                    <!-- Release License -->
                    <TextBlock TextWrapping="Wrap"
                               Text="Remove license of BatchProcess from this machine and release the license back to the server ready to be transferred to another machine." />
                    <!--<Button Grid.Row="0"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe2fe;" />
                            <Label Classes="akko"
                                   Content="Release License" />
                        </StackPanel>
                    </Button>-->
                    <IconButton IconText="&#xe2fe;"
                                Content="Release License"
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch" />

                    <!-- Skip Files -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               TextWrapping="Wrap"
                               Text="Skip files if only Open, Save (Optional) and Close are valid actions." />
                    <CheckBox Grid.Row="2"
                              Grid.Column="2" />

                    <!-- Duplicate Entries -->
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               TextWrapping="Wrap"
                               Text="Allow duplicate entries of the same file in project list" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="2" />
                </Grid>
            </StackPanel>

            <!-- Locations -->
            <StackPanel>
                <Label Classes="h2"
                       Content="Locations" />
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Add or remove the locations to search for Reporter Templates, 
Macros, Actions and other custom files or templates." />
                        <TextBlock TextWrapping="Wrap"
                                   Text="* All sub-directories will be searched automatically" />
                    </StackPanel>

                    <Button Classes="outline small"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="+ Folder"
                            HorizontalAlignment="Stretch"
                            Margin="10 0 0 0" />
                </Grid>
                <ListBox ItemsSource="{Binding LocationPaths}"
                         Margin="0 10" />
            </StackPanel>

        </StackPanel>

        <!-- Right Side Content -->
        <StackPanel Grid.Column="1"
                    Grid.Row="1"
                    Spacing="15"
                    Margin="25">
            <!-- SolidWorks Host -->
            <StackPanel>
                <Label Classes="h2"
                       Content="SolidWorks Host" />
                <TextBlock TextWrapping="Wrap">
                    BatchProcess can work locally on the current machine, or on any machine accessible
                    over the network or even internet.<LineBreak /><LineBreak />
                    Enter the machines IP address, network name or localhost for this machine.
                </TextBlock>
                <ComboBox ItemsSource="{Binding LocationPaths}" />
                <Label Content="Connection established" />
            </StackPanel>

            <!-- PDM Enterprise -->
            <StackPanel>
                <Label Classes="h2"
                       Content="PDM Enterprise" />
                <TextBlock TextWrapping="Wrap"
                           Text="If you are using PDM Enterprise enter the credentials below and test login. BatchProcess can
then automatically handle checking in and out files from PDM Enterprise." />
                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto, Auto"
                      Margin="0 10">
                    <Label Grid.Row="0"
                           Grid.Column="0">
                        Vault Name
                    </Label>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding LocationPaths}"
                              Grid.Row="1"
                              Margin="0 0 10 0"
                              HorizontalAlignment="Stretch" />
                    <Label Grid.Row="0"
                           Grid.Column="1">
                        Username
                    </Label>
                    <TextBox Grid.Row="1"
                             Margin="0 0 10 0"
                             Grid.Column="1">
                        luke
                    </TextBox>
                    <Label Grid.Row="0"
                           Grid.Column="2">
                        Password
                    </Label>
                    <TextBox Grid.Row="1"
                             PasswordChar="*"
                             Grid.Column="2">
                        somepassword
                    </TextBox>
                </Grid>
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <!--<Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe23e;" />
                            <Label Classes="akko"
                                   Content="Login" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe094;" />
                            <Label Classes="akko"
                                   Content="Refresh Vault" />
                        </StackPanel>
                    </Button>-->
                    <IconButton IconText="&#xe23e;"
                                Content="Login"
                                HorizontalAlignment="Stretch" />
                    <IconButton Classes="outline"
                                IconText="&#xe094;"
                                Content="Refresh Vault"
                                HorizontalAlignment="Stretch" />
                </StackPanel>
                <Label Content="Connection Established"
                       Margin="0 0 0 0" />
            </StackPanel>

            <!-- Settings Cache -->
            <StackPanel>
                <Label Classes="h2"
                       Content="Settings Cache" />
                <TextBlock TextWrapping="Wrap">
                    Various settings are stored locally including Processes, Actions, Macros, Reports and History.
                    <LineBreak /><LineBreak />
                    If you are experiencing issues you can try clearing the cache (this won't remove the license).
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            Margin="0 10">
                    <!--<Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xec54;" />
                            <Label Classes="akko"
                                   Content="Clear Cache" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe5de;" />
                            <Label Classes="akko"
                                   Content="Export Cache" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="icon"
                                   Content="&#xe20c;" />
                            <Label Classes="akko"
                                   Content="Import Cache" />
                        </StackPanel>
                    </Button>-->
                    <IconButton Classes="alert"
                                IconText="&#xec54;"
                                Content="Clear Cache"
                                HorizontalAlignment="Stretch" />
                    <IconButton IconText="&#xe5de;"
                                Content="Export Cache"
                                HorizontalAlignment="Stretch" />
                    <IconButton Classes="outline"
                                IconText="&#xe20c;"
                                Content="Import Cache"
                                HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>