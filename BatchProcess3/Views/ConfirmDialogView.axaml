<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             MinWidth="300"
             Width="{Binding DialogWidth}"
             Height="{Binding DialogHeight}"
             x:Class="BatchProcess3.Views.ConfirmDialogView"
             Foreground="{DynamicResource PrimaryForeground}"
             Background="Transparent"
             x:DataType="vm:ConfirmDialogViewModel">
    <Design.DataContext>
        <vm:ConfirmDialogViewModel />
    </Design.DataContext>

    <!-- Main Dialog Window -->
    <Border Background="{DynamicResource PrimaryBackground}"
            BorderBrush="{DynamicResource DefaultGradient}"
            BorderThickness="{DynamicResource PrimaryBorderThickness}"
            CornerRadius="20"
            ClipToBounds="True"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource PrimaryBackgroundColor2}" />
        </Border.Effect>

        <!--<StackPanel>-->
        <Grid RowDefinitions="Auto, *">

            <!-- Title -->
            <Border Background="{DynamicResource PrimaryBackgroundGradient}"
                    CornerRadius="20 20 0 0">
                <TextBlock Text="{Binding Title}"
                           Padding="10"
                           FontSize="18"
                           FontWeight="Bold" />
            </Border>

            <!--<Border Padding="20">
                <StackPanel Spacing="20">

                    ~1~ Description @1@
                    <StackPanel Orientation="Horizontal">
                        <Label Classes="icon"
                               Content="{Binding IconText}" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding Message}" />
                    </StackPanel>

                    ~1~ Buttons @1@
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                        <Button Content="{Binding CancelText}"
                                Command="{Binding CancelCommand}"
                                MinWidth="70"
                                HorizontalContentAlignment="Center"
                                Classes="danger outline" />
                        <Button Content="{Binding ConfirmText}"
                                Command="{Binding ConfirmCommand}"
                                MinWidth="70"
                                HorizontalContentAlignment="Center"
                                Classes="success" />
                    </StackPanel>

                </StackPanel>

            </Border>-->
            <Grid Grid.Row="1"
                  RowDefinitions="Auto, Auto, *, Auto"
                  Margin="20">


                <!-- Description -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, 10, *">
                    <Label Classes="icon" Content="{Binding IconText}" FontSize="30" />
                    <TextBlock Grid.Column="2" TextWrapping="Wrap"
                               Text="{Binding Message}"
                               FontSize="18" VerticalAlignment="Center" Margin="0 -5 0 0" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText}"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AlertGradient}"
                           Margin="0 10" />

                <!-- Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Spacing="10"
                            IsVisible="{Binding !Busy}">
                    <Button Command="{Binding CancelCommand}"
                            Classes="danger outline">
                        <TextBlock MinWidth="70" TextAlignment="Center" Text="{Binding CancelText}" />
                    </Button>
                    <Button Command="{Binding ConfirmCommand}"
                            Classes="success">
                        <TextBlock MinWidth="70" TextAlignment="Center" Text="{Binding ConfirmText}" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{Binding ProgressText}"
                           IsVisible="{Binding Busy}"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ActiveGradientText}"
                           Margin="0 10" />

            </Grid>

            <!--</StackPanel>-->
        </Grid>
    </Border>
</UserControl>